<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BOAR's privacy manifest (iOS and Mac, same file). BOAR collects nothing and tracks no one: questions, answers,
  documents and models stay on the device. The only network use is what the user starts (model and pack downloads,
  Hugging Face search). Required-reason APIs, audited 2026-11-06:
  - UserDefaults: the app's own settings (CA92.1).
  - File timestamps: files inside the app container (models, evaluation runs, downloads) (C617.1).
  - Disk space: checked before model and pack downloads (E174.1) and shown in Settings → storage (85F4.1).
  Re-audit when adding systemUptime/mach_absolute_time, activeInputModes, or reading dates of user-picked files.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
				<string>85F4.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
