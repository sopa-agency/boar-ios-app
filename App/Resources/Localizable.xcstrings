    },
    "This %@ has no magnetometer, so it can't show a compass." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ não tem magnetômetro, então não pode mostrar uma bússola."
          }
        }
      }
    },
    "This article is no longer on this %@: its pack or collection was removed." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este artigo não está mais neste %@: o pacote ou a coleção foi removido."
          }
        }
      }
    },
    "This can't be undone. Every downloaded model, knowledge pack, document and chat is deleted, and setup starts over." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser desfeito. Todos os modelos baixados, pacotes de conhecimento, documentos e conversas são apagados, e a configuração recomeça."
          }
        }
      }
    },
    "This deletes \"%@\" from BOAR. This can't be undone: export it first to keep a copy." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga \"%@\" do BOAR. Não pode ser desfeito: exporte antes para guardar uma cópia."
          }
        }
      }
    },
    "This frees %@ on your %@. Its topics can't be searched until you download it again." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso libera %@ no seu %@. Os temas dele não podem ser pesquisados até você baixar de novo."
          }
        }
      }
    },
    "This frees %@ on your %@. You can download it again later." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso libera %@ no seu %@. Você pode baixar de novo depois."
          }
