    "Theme" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema"
          }
        }
      }
    },
    "Thinking" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensando"
          }
        }
      }
    },
    "Thinking lets a reasoning model think before it answers; Auto keeps it off so the answer isn't cut short. The Auto time limit grows with the answer length; an answer that hits it keeps what it wrote." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensar deixa um modelo de raciocínio pensar antes de responder; o Auto deixa desligado para a resposta não ser cortada. O limite de tempo do Auto cresce com o tamanho da resposta; uma resposta que bate no limite mantém o que escreveu."
          }
        }
      }
    },
    "Thinking…" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensando…"
          }
        }
      }
    },
    "Thinks before answering, needs more memory" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensa antes de responder, precisa de mais memória"
          }
        }
      }
    },
    "This %@ has %@ of memory, so Fast is recommended." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ tem %@ de memória, então o Rápido é o recomendado."
          }
