{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" and its messages are deleted from this %@." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" e as mensagens dele são apagados deste %@."
          }
        }
      }
    },
    "\"%@\" has no text BOAR could read." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" não tem texto que o BOAR consiga ler."
          }
        }
      }
    },
    "\"%@\" is password-protected. Password-protected PDFs aren't supported." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" é protegido por senha. PDFs protegidos por senha não são aceitos."
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ & Storage" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e armazenamento"
          }
        }
      }
    },
    "%@ Deep Research splits your question into parts. Slower." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A Pesquisa Profunda divide sua pergunta em partes. Mais lento."
          }
        }
      }
    },
    "%@ Recommended" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Recomendado"
          }
        }
      }
