        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curto"
          }
        }
      }
    },
    "Short answer: health questions are kept brief." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resposta curta: perguntas de saúde ficam breves."
