      }
    },
    "Succinct & Direct for quick replies, Thorough & Detailed for full explanations (the default), Personal Files to answer only from your own documents." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucinto e Direto para respostas rápidas, Completo e Detalhado para explicações inteiras (o padrão), Arquivos pessoais para responder só a partir dos seus documentos."
