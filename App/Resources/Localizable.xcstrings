      }
    },
    "This %@ has less than 8 GB of RAM: large models may run out of memory." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ tem menos de 8 GB de RAM: modelos grandes podem ficar sem memória."
