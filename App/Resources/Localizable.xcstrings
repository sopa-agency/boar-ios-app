        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parte que o BOAR usou está marcada."
          }
        }
      }
    },
    "The same model at different sizes: smaller versions are faster and lighter, larger ones answer a little better. Downloads also appear in Models." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mesmo modelo em tamanhos diferentes: versões menores são mais rápidas e leves, as maiores respondem um pouco melhor. Os downloads também aparecem em Modelos."
          }
        }
      }
    },
