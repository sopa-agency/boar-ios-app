{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" and its messages are deleted from this %@." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" e as mensagens dele são apagados deste %@."
          }
        }
      }
    },
    "\"%@\" has no text BOAR could read." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" não tem texto que o BOAR consiga ler."
          }
        }
      }
    },
    "\"%@\" is password-protected. Password-protected PDFs aren't supported." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" é protegido por senha. PDFs protegidos por senha não são aceitos."
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ & Storage" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e armazenamento"
          }
        }
      }
    },
    "%@ Deep Research splits your question into parts. Slower." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A Pesquisa Profunda divide sua pergunta em partes. Mais lento."
          }
        }
      }
    },
    "%@ Version" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão do %@"
          }
        }
      }
    },
    "%@ couldn't be loaded" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar %@"
          }
        }
      }
    },
    "%@ doesn't give apps the battery temperature: this is its own heat level, the one that makes it slow the %@ down." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ não passa a temperatura da bateria para os apps: este é o nível de calor do próprio sistema, o que faz ele deixar o %2$@ mais lento."
          }
        }
      }
    },
    "%@ free on this %@" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ livres neste %@"
          }
        }
      }
    },
    "%@ is classified: still in testing. Check back soon." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é confidencial: ainda em teste. Volte em breve."
          }
        }
      }
    },
    "%@ is off. Turn it on in Plugins ›" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está desligado. Ligue em Plugins ›"
          }
        }
      }
    },
    "%@ leaked, and it's yours: tap it to open it and switch it on. Still in testing." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vazou, e é seu: toque para abrir e ligar. Ainda em teste."
          }
        }
      }
    },
    "%@ leaked. Still in testing, with no release date." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vazou. Ainda em testes, sem data de lançamento."
          }
        }
      }
    },
    "%@ may not fit in this %@'s memory." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode não caber na memória deste %@."
          }
        }
      }
    },
    "%@ may not fit in this %@'s memory. A smaller model, such as %@ (about 1 GB), fits better." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode não caber na memória deste %@. Um modelo menor, como o %@ (cerca de 1 GB), cabe melhor."
          }
        }
      }
    },
    "%@ more before %@ closes it" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mais %1$@ antes que o %2$@ feche o app"
          }
        }
      }
    },
    "%@ needed more memory than this %@ had free, so BOAR closed while loading it. Answers now use %@." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisou de mais memória do que este %@ tinha livre, então o BOAR fechou ao carregá-lo. As respostas agora usam %@."
          }
        }
      }
    },
    "%@ needed more memory than this %@ had free, so BOAR closed while loading it. Pick a smaller model." : {
