    "Fastest answers. The %@ gets warmer and uses more battery, and answers have no time limit (use Stop). Best while charging." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respostas mais rápidas. O %@ esquenta mais e gasta mais bateria, e as respostas não têm limite de tempo (use Parar). Melhor carregando."
          }
        }
      }
    },
    "Fastest — 2–3 short sentences, no preamble." : {
