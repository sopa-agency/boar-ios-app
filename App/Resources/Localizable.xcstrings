    "%@ Version" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão do %@"
          }
        }
      }
    },
    "%@ couldn't be loaded" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar %@"
          }
        }
      }
    },
    "%@ doesn't give apps the battery temperature: this is its own heat level, the one that makes it slow the %@ down." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ não passa a temperatura da bateria para os apps: este é o nível de calor do próprio sistema, o que faz ele deixar o %2$@ mais lento."
          }
        }
      }
    },
    "%@ free on this %@" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ livres neste %@"
          }
        }
      }
    },
    "%@ is classified: still in testing. Check back soon." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é confidencial: ainda em teste. Volte em breve."
          }
        }
      }
    },
    "%@ leaked, and it's yours: tap it to open it and switch it on. Still in testing." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vazou, e é seu: toque para abrir e ligar. Ainda em teste."
          }
        }
      }
    },
    "%@ leaked. Still in testing, with no release date." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vazou. Ainda em testes, sem data de lançamento."
          }
        }
      }
    },
    "%@ more before %@ closes it" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mais %1$@ antes que o %2$@ feche o app"
          }
        }
      }
    },
    "%@ needed more memory than this %@ had free, so BOAR closed while loading it. Answers now use %@." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisou de mais memória do que este %@ tinha livre, então o BOAR fechou ao carregá-lo. As respostas agora usam %@."
          }
        }
      }
    },
    "%@ needed more memory than this %@ had free, so BOAR closed while loading it. Pick a smaller model." : {
